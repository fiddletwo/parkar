{
    "lsp": {
        "luau-lsp": {
            "settings": {
                "roblox": {
                    "security-level": "roblox_script"
                },
                "fflags": {
                    "enable_new_solver": true
                },
                "luau-lsp": {
                    "ignoreGlobs": [
                        "**/_Index/**",
                    ],
                    "completion": {
                        "imports": {
                            "ignoreGlobs": ["**/_Index/**", "**/.pesde/**"],
                        },
                    },
                }
            }
        }
    },
    "languages": {
        "Luau": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "stylua",
                    "arguments": ["--respect-ignores", "-"],
                },
            },
        }
    }
}
